<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tripous.Desktop.ConfigDialog"
        Width="900"
        Height="640"
        MinWidth="760"
        MinHeight="500"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Application Settings">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scope" VerticalAlignment="Center"/>
                <ComboBox Name="cboScope" Width="140"/>
                <TextBlock Name="txtOwner" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="txtMessage" Grid.Column="0" VerticalAlignment="Center"/>
                <Button Name="btnSave" Grid.Column="1" Content="Save" MinWidth="90" Margin="0,0,8,0"/>
                <Button Name="btnClose" Grid.Column="2" Content="Close" MinWidth="90"/>
            </Grid>
        </Border>
        <TabControl Name="tabControl"/>
    </DockPanel>
</Window>
