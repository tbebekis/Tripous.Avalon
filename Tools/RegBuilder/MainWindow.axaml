<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    mc:Ignorable="d"
    Width="1100"
    Height="750"
    x:Class="RegBuilder.MainWindow"
    Padding="10"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    Title="RegBuilder">
    
    <Window.Styles>
        <Style Selector="ae|TextEditor">
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ShowLineNumbers" Value="True"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Styles>    

    <DockPanel LastChildFill="True">
        
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <Button Name="btnAdd" Content="Add" Width="80" HorizontalContentAlignment="Center"/>
                <Button Name="btnEdit" Content="Edit" Width="80" HorizontalContentAlignment="Center"/>
                <Button Name="btnDelete" Content="Delete" Width="80" HorizontalContentAlignment="Center"/>
                
                <ComboBox Name="cboProjects" Width="200" PlaceholderText="Select Project..."/>
                
                <Button Name="btnExecute" Content="Execute" Width="100" HorizontalContentAlignment="Center"/>
                <Button Name="btnOpenWorkingFolder" Content="Open Working Folder" HorizontalContentAlignment="Center"/>
                <Button Name="btnCopyToOutputFolder" Content="Copy To Output Folder" HorizontalContentAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Grid RowDefinitions="*, 4, 180">
            
            <TabControl Grid.Row="0">
                <TabItem Header="Project Log" Name="tabProjectLog">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <TextBox Name="edtProjectLog" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Watermark="Project log details..."/>
                    </Border>
                </TabItem>
                
                <TabItem Header="Schema" Name="tabSchema">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtSchema"/>
                    </Border>
                </TabItem>
                
                <TabItem Header="Modules" Name="tabModules">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtModules"/>
                    </Border>
                </TabItem>
                
                <TabItem Header="Forms" Name="tabForms">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtForms"/>
                    </Border>
                </TabItem>
                                
                <TabItem Header="Lookups" Name="tabLookups">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtLookups"/>
                    </Border>
                </TabItem>
                
                <TabItem Header="Locators" Name="tabLocators">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtLocators"/>
                    </Border>
                </TabItem>
                
                <TabItem Header="Code Providers" Name="tabCodeProviders">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtCodeProviders"/>
                    </Border>
                </TabItem>
                
                <TabItem Header="SQL" Name="tabSql">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                        <ae:TextEditor Name="edtSql"/>
                    </Border>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows"/>

            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                <TextBox Name="edtLog" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Watermark="System log..."/>
            </Border>
            
        </Grid>
    </DockPanel>
</Window>
