<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordManager.MainWindow"
        Title="Password Manager"
        Width="1200"
        Height="760"
        WindowState="Maximized">
  <DockPanel>
    <Menu Name="MainMenu" DockPanel.Dock="Top"/>
    <Border Classes="ToolbarContainer" DockPanel.Dock="Top">
      <StackPanel Name="pnlToolBar" Classes="ToolBar"/>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="6,3">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="lblStatus" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBlock Name="lblDetails" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="270,5,*" RowDefinitions="*,5,150">
      <TabControl Name="pagerSideBar" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"/>
      <GridSplitter Name="Splitter1" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" ResizeDirection="Columns"/>
      <TabControl Name="pagerContent" Grid.Column="2" Grid.Row="0"/>
      <GridSplitter Name="Splitter2" Grid.Column="2" Grid.Row="1" ResizeDirection="Rows"/>
      <TextBox Name="edtLog" Grid.Column="2" Grid.Row="2" FontFamily="Cascadia Code, Consolas, Monospace" FontSize="11" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
  </DockPanel>
</Window>
