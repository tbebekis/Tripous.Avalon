<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordManager.UnlockVaultDialog"
        Title="Unlock Vault"
        Width="380"
        Height="190"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="110,*" Margin="16" RowSpacing="8" ColumnSpacing="8">
    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Text="Enter the master password to unlock the vault."/>
    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" VerticalAlignment="Center"/>
    <TextBox Name="edtPassword" Grid.Row="1" Grid.Column="1" PasswordChar="*"/>
    <TextBlock Name="lblMessage" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="Crimson"/>
    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="btnOK" Content="OK" Width="90" IsDefault="True"/>
      <Button Name="btnCancel" Content="Cancel" Width="90" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
