<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MiniCrm.SetPasswordDialog"
    Title="Set Password"
    Width="420"
    Height="260"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    ShowInTaskbar="False">
    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Set Password" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Name="lblUser" Opacity="0.75"/>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Password" VerticalAlignment="Center"/>
                <TextBox Name="edtPassword" Grid.Row="0" Grid.Column="1" PasswordChar="*"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Confirm Password" VerticalAlignment="Center"/>
                <TextBox Name="edtConfirmPassword" Grid.Row="1" Grid.Column="1" PasswordChar="*"/>
                <TextBlock Name="lblMessage" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Classes="ErrorText"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="btnOK" Content="OK" IsDefault="True"/>
                <Button Name="btnCancel" Content="Cancel" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
