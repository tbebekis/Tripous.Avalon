<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extras="clr-namespace:Avalonia.Controls;assembly=Tripous.Avalonia.Controls"
             x:Class="tERP.ResourceTranslationsForm">
    <Grid Margin="4">
        <extras:GroupGrid Name="GridTranslations"
                          IsToolBarVisible="True"
                          IsGroupPanelVisible="False"
                          IsFilterPanelVisible="True"
                          IsTotalsSummaryVisible="False"
                          IsInsertButtonVisible="False"
                          IsDeleteButtonVisible="True"
                          IsEditButtonVisible="False"/>
    </Grid>
</UserControl>
