<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="tERP.ReadOnlyViewForm">
    <DockPanel Margin="2,2,2,2">
        <Border DockPanel.Dock="Top" Classes="ToolbarContainer">
            <StackPanel Name="pnlToolBar" Classes="ToolBar" MinHeight="32">
            </StackPanel>
        </Border>
        <Grid Name="pnlMain" ColumnDefinitions="250,4,*">
            <DockPanel Name="pnlSideBar" Grid.Column="0" MinWidth="250" Background="#F5F5F5">
                <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="8">
                    <TextBlock Text="Filters" FontWeight="SemiBold"/>
                </Border>
                <ScrollViewer>
                    <StackPanel Name="pnlFilters" Margin="10" Spacing="10">
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            <GridSplitter Name="Splitter" Grid.Column="1" Width="4" Background="#E0E0E0"/>
            <DataGrid Name="grid"
                      Grid.Column="2"
                      IsReadOnly="True"
                      BorderThickness="1,0,0,0"
                      BorderBrush="Gray"/>
        </Grid>
    </DockPanel>
</UserControl>
