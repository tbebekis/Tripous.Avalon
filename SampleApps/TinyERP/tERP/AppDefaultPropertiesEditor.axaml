<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="tERP.AppDefaultPropertiesEditor">
    <TabControl Name="tabControl" Margin="8">
        <TabItem Header="Sales">
            <ScrollViewer>
                <StackPanel Name="pnlSales" Margin="10" Spacing="8"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Purchases">
            <ScrollViewer>
                <StackPanel Name="pnlPurchase" Margin="10" Spacing="8"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Line Grid">
            <Grid Margin="10" RowDefinitions="Auto,8,*" ColumnDefinitions="*,Auto,*">
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Document" VerticalAlignment="Center"/>
                    <ComboBox Name="cboLineGridKind" Width="140"/>
                </StackPanel>
                <DockPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Available Fields" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox Name="lstAvailable"/>
                </DockPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="8" Spacing="8">
                    <Button Name="btnAddField" Content="→" Width="36" Height="32"/>
                    <Button Name="btnRemoveField" Content="←" Width="36" Height="32"/>
                    <Button Name="btnMoveFieldUp" Content="↑" Width="36" Height="32"/>
                    <Button Name="btnMoveFieldDown" Content="↓" Width="36" Height="32"/>
                </StackPanel>
                <DockPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Selected Fields" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox Name="lstSelected"/>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
