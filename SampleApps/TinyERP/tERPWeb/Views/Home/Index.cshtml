@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">
    <section class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>TinyERP Web workspace</p>
        </div>
        <div class="dashboard-actions">
            <a href="/demos">MVC Server Demos</a>
            <a href="/web-demos/">Static JavaScript Demos</a>
        </div>
    </section>

    <section class="dashboard-grid">
        <article class="dashboard-panel">
            <h2>Sales</h2>
            <dl>
                <div>
                    <dt>Open invoices</dt>
                    <dd>0</dd>
                </div>
                <div>
                    <dt>Pending orders</dt>
                    <dd>0</dd>
                </div>
            </dl>
        </article>
        <article class="dashboard-panel">
            <h2>Purchases</h2>
            <dl>
                <div>
                    <dt>Open invoices</dt>
                    <dd>0</dd>
                </div>
                <div>
                    <dt>Pending orders</dt>
                    <dd>0</dd>
                </div>
            </dl>
        </article>
        <article class="dashboard-panel">
            <h2>Stock</h2>
            <dl>
                <div>
                    <dt>Movements</dt>
                    <dd>0</dd>
                </div>
                <div>
                    <dt>Reservations</dt>
                    <dd>0</dd>
                </div>
            </dl>
        </article>
    </section>
</div>
