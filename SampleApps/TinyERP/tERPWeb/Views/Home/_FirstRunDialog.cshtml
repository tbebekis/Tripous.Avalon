<div class="app-startup-dialog" data-dialog-kind="first-run">
    <div class="app-dialog-header">
        <div class="app-dialog-title">First Application Run</div>
        <div class="app-dialog-subtitle">A system administrator account must be created.</div>
    </div>
    <div class="app-dialog-grid app-dialog-grid-first-run">
        <label for="FirstRunFullName">Full Name</label>
        <input id="FirstRunFullName" name="FullName" type="text" autocomplete="name" autofocus/>
        <label for="FirstRunUserName">User Name</label>
        <input id="FirstRunUserName" name="UserName" type="text" autocomplete="username"/>
        <label for="FirstRunPassword">Password</label>
        <input id="FirstRunPassword" name="Password" type="password" autocomplete="new-password"/>
        <label for="FirstRunConfirmPassword">Confirm Password</label>
        <input id="FirstRunConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password"/>
    </div>
    <div class="app-dialog-message" data-role="message"></div>
</div>
