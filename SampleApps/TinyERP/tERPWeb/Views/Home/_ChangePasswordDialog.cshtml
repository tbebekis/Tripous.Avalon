<div class="app-change-password-dialog"
     data-dialog-kind="change-password"
     data-setup="{ClassName: 'app.ChangePasswordDialog', JavaScriptFiles: ['/js/dialogs/change-password-dialog.js']}">
    <div class="app-dialog-header">
        <div class="app-dialog-title">Change Password</div>
        <div class="app-dialog-user" data-role="user"></div>
    </div>
    <div class="app-dialog-grid app-dialog-grid-change-password">
        <label for="ChangePasswordCurrentPassword">Current Password</label>
        <input id="ChangePasswordCurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" autofocus/>
        <label for="ChangePasswordNewPassword">New Password</label>
        <input id="ChangePasswordNewPassword" name="NewPassword" type="password" autocomplete="new-password"/>
        <label for="ChangePasswordConfirmPassword">Confirm Password</label>
        <input id="ChangePasswordConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password"/>
    </div>
    <div class="app-dialog-message" data-role="message"></div>
</div>
