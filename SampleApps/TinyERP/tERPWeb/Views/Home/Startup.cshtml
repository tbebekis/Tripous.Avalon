@{
    ViewData["Title"] = "Startup";
    string ApplicationName = Tripous.SysConfig.AppName;
}

<section id="AppStartup" class="app-startup" aria-label="Application startup">
    <div class="app-startup-actions">
        <button id="AppStartupLoginButton" class="app-startup-login-button" type="button">Login</button>
    </div>
    <div class="app-startup-title">@ApplicationName</div>
    <div id="AppStartupMessage" class="app-startup-message">Starting...</div>
    <progress id="AppStartupProgress" class="app-startup-progress tp-ProgressBar" aria-label="Startup progress"></progress>
</section>
