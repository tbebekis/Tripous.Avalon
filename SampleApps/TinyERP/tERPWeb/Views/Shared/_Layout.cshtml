<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - tERPWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/tp/css/tp-Variables.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/tp/css/tp.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/tp/css/font-awesome.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/tp/css/glyphicons.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/tp/css/tp-UI.css" asp-append-version="true"/>
    <script src="~/tp/js/tp.js" asp-append-version="true"></script>
    <script src="~/tp/js/tp-Data.js" asp-append-version="true"></script>
    <script src="~/tp/js/tp-UI.js" asp-append-version="true"></script>
    <script src="~/tp/js/tp-Grid.js" asp-append-version="true"></script>
</head>
<body>
