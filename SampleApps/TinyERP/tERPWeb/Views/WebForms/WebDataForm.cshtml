@model Tripous.WebDesk.WebFormDef
@{
    string JsFormClassType = !string.IsNullOrWhiteSpace(Model.JsFormClassType) ? Model.JsFormClassType : "tp.WebDataForm";
    string ItemViewName = Model.ItemViewName;
    string ItemViewFileName = ItemViewName.EndsWith(".cshtml", StringComparison.OrdinalIgnoreCase) ? ItemViewName : $"{ItemViewName}.cshtml";
    string ItemViewPath = string.IsNullOrWhiteSpace(ItemViewName)
        ? string.Empty
        : (ItemViewName.StartsWith("/", StringComparison.Ordinal) ? ItemViewName : $"/Views/WebForms/{ItemViewFileName}");
    string DataSetup = Tripous.Json.Serialize(new
    {
        WebFormName = Model.Name,
        ModuleName = Model.Module,
        Module = Model.Module,
        IsReadOnly = Model.IsReadOnly,
        JavaScriptFiles = Model.JavaScriptFiles,
        CssFiles = Model.CssFiles,
        JsFormClassType
    });
}
<div class="tp-WebDataForm" data-setup='@Html.Raw(DataSetup)'>
    <div data-role="toolbar"></div>
    <div data-role="body" class="tp-WebDataForm-Body">
        <aside data-role="filters" class="tp-WebDataForm-FilterPane" hidden>
            <div data-role="select-bar"></div>
            <div data-role="filter-panel-list">
                @await Html.PartialAsync("/Views/WebForms/_SelectFilters.cshtml", Model)
            </div>
        </aside>
        <div data-role="filter-splitter" class="tp-Splitter" hidden></div>
        <section data-role="work-pane" class="tp-WebDataForm-WorkPane">
            <section data-role="list-page" class="tp-WebDataForm-ListPage">
                <div data-role="list-grid"></div>
            </section>
            <section data-role="item-page" class="tp-WebDataForm-ItemPage" hidden>
                <div data-role="item-page-main" class="tp-WebDataForm-ItemPageMain">
                    @if (!string.IsNullOrWhiteSpace(ItemViewPath))
                    {
                        @await Html.PartialAsync(ItemViewPath, Model)
                    }
                </div>
                <div data-role="factbox-splitter" class="tp-Splitter tp-WebDataForm-FactBoxSplitter" hidden></div>
                <aside data-role="factbox-pane" class="tp-WebDataForm-FactBoxPane" hidden>
                    <div data-role="factbox-tabs" class="tp-TabControl tp-WebDataForm-FactBoxTabs"></div>
                </aside>
            </section>
        </section>
    </div>
</div>
