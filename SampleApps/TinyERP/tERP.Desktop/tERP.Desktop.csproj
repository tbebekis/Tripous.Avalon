<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <NoWarn>$(NoWarn);NU1510;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4"/>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Tripous.Data\Tripous.Data.csproj" />
        <ProjectReference Include="..\..\..\Tripous.Desktop\Tripous.Desktop.csproj" />
        <ProjectReference Include="..\..\..\Tripous\Tripous.csproj" />

        <ProjectReference Include="..\tERP.Common\tERP.Common.csproj" />
        <ProjectReference Include="..\tERP.Data\tERP.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Tripous.Avalonia.Controls">
        <HintPath>..\..\..\..\Tripous.Avalonia.Controls\Tripous.Avalonia.Controls\bin\Debug\net10.0\Tripous.Avalonia.Controls.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
