<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tripous.Data\Tripous.Data.csproj" />
    <ProjectReference Include="..\..\Tripous.Logging\Tripous.Logging.csproj" />
    <ProjectReference Include="..\..\Tripous.Web\Tripous.Web.csproj" />
    <ProjectReference Include="..\..\Tripous\Tripous.csproj" />
    <ProjectReference Include="..\WebApp.Data\WebApp.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\js-src\" />
  </ItemGroup>

  <Target Name="BuildTripousWebJavaScriptBundles"
          BeforeTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)/wwwroot/js-src')">
    <Message Importance="High" Text="Building Tripous Web JavaScript bundles." />
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../Tools/TripousWebBundler/TripousWebBundler.csproj&quot; -- --source &quot;$(MSBuildProjectDirectory)/wwwroot/js-src&quot; --output &quot;$(MSBuildProjectDirectory)/wwwroot/tp/js&quot; --extension js" />
  </Target>

</Project>
