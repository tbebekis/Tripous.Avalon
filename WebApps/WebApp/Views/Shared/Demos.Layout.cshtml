@{
    string PageTitle = ViewData["Title"] as string ?? "Tripous Web Demos";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@PageTitle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/demos.css" asp-append-version="true" />
    <script src="~/ace-1.4.13/src-min-noconflict/ace.js"></script>
    <script src="~/js/tp.js" asp-append-version="true"></script>
    <script src="~/js/demos.js" asp-append-version="true"></script>
</head>
<body class="demo-page">
    <script>
        Demos.RegisterSourcePreview();
    </script>

    <main class="demo-body">
        @RenderBody()
    </main>

    <section id="DemoSourcePanel" class="demo-source-panel" hidden>
        <div class="demo-source-tabs">
            <button type="button" data-demo-source-tab="html">HTML</button>
            <button type="button" data-demo-source-tab="javascript">JavaScript</button>
        </div>
        <div class="demo-source-page" data-demo-source-page="html">
            <pre id="DemoHtmlEditor"></pre>
        </div>
        <div class="demo-source-page" data-demo-source-page="javascript">
            <pre id="DemoJavaScriptEditor"></pre>
        </div>
    </section>

    <section id="CommonHtmlContainer" style="display: none;">
        @await Html.PartialAsync("Demos.Common")
    </section>

    @await Html.PartialAsync("Layout.MessageList")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
