@{
    ViewData["Title"] = "tp.Ready";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.Ready</h1>

<p>This demo checks that a <code>tp.Ready()</code> callback is executed by the Tripous runtime lifecycle.</p>

<div class="html-code">
    <div class="demo-panel demo-panel-wide">
        <pre id="DemoOutput"></pre>
    </div>
</div>

<script class="js-code">
    tp.Ready(function () {
        var Lines = [
            "tp.Ready callback executed.",
            "tp.IsReady = " + tp.IsReady,
            "document.readyState = " + document.readyState,
            "time = " + new Date().toLocaleTimeString()
        ];

        tp.Text("#DemoOutput", Lines.join("\n"));
    });
</script>
