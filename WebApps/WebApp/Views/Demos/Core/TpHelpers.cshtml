@{
    ViewData["Title"] = "tp Helpers";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp Helpers</h1>

<p>This demo checks basic type and object helper functions.</p>

<div class="html-code">
    <div class="demo-panel demo-panel-wide">
        <button id="DemoButton" type="button">Run</button>
        <pre id="DemoOutput"></pre>
    </div>
</div>

<script class="js-code">
    tp.Ready(function () {
        tp.On("#DemoButton", "click", function () {
            var Source = { Name: "Tripous" };
            var Target = {};
            tp.Assign(Target, Source);

            var Values = [
                ["string", "Tripous", tp.IsString("Tripous")],
                ["array", "[1, 2, 3]", tp.IsArray([1, 2, 3])],
                ["object", "{ Name: \"Tripous\" }", tp.IsObject(Source)],
                ["nil", "null", tp.IsNil(null)],
                ["blank", "\"   \"", tp.IsBlank("   ")],
                ["number", "42", tp.IsNumber(42)],
                ["ToArray", "NodeList", tp.IsArray(tp.ToArray(document.querySelectorAll("button")))],
                ["Assign", "Target.Name", Target.Name === "Tripous"]
            ];

            tp.Text("#DemoOutput", Values.map(function (Item) {
                return Item[0] + " | " + Item[1] + " | " + Item[2];
            }).join("\n"));
        });
    });
</script>
