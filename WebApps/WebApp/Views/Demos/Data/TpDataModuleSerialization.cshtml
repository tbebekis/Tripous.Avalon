@{
    ViewData["Title"] = "tp.DataSet from JsonDataModule";
    string DataModuleJson = ViewData["DataModuleJson"] as string;
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.DataSet from JsonDataModule</h1>

<p>
    A server-side <code>DataModule</code> is serialized to a <code>JsonDataModule</code> JSON packet.
    The browser receives that packet and creates a <code>tp.DataSet</code> from <code>packet.DataSet</code>.
</p>

<pre><code>var Packet = serverJsonDataModule;
var DataSet = new tp.DataSet(Packet.DataSet);</code></pre>

<style>
    .data-module-demo-layout {
        display: grid;
        gap: 14px;
        max-width: 1080px;
    }
    .data-module-demo-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 8px;
    }
    .data-module-demo-summary div {
        padding: 8px 10px;
        border: 1px solid #d0d7de;
        background: #f7f9fb;
    }
    .data-module-demo-table-wrap {
        overflow: auto;
        border: 1px solid #d0d7de;
    }
    .data-module-demo-table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
    }
    .data-module-demo-table th,
    .data-module-demo-table td {
        padding: 7px 9px;
        border-bottom: 1px solid #d0d7de;
        text-align: left;
        white-space: nowrap;
    }
    .data-module-demo-table th {
        background: #f0f3f6;
        font-weight: 600;
    }
    .data-module-demo-table td[data-align="right"] {
        text-align: right;
    }
    .data-module-demo-table td[data-align="center"] {
        text-align: center;
    }
    .data-module-demo-json {
        box-sizing: border-box;
        min-height: 220px;
        max-height: 420px;
        margin: 0;
        padding: 12px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
        white-space: pre;
    }
</style>

<div class="html-code">
    <div class="data-module-demo-layout">
        <div id="DataModuleSummary" class="data-module-demo-summary"></div>
        <div id="DataModuleTableHost" class="data-module-demo-table-wrap"></div>
        <pre id="DataModuleJsonText" class="data-module-demo-json"></pre>
    </div>
</div>

<script class="js-code">
    tp.Ready(function () {
        var Packet = @Html.Raw(DataModuleJson);
        var DataSet = new tp.DataSet(Packet.DataSet);
        var Table = DataSet.FindTable(Packet.ItemTableName);

        var FormatValue = function (Column, Value) {
            if (tp.IsNil(Value))
                return "";
            if (Column.IsBoolean)
                return Value === true || Value === 1 ? "Yes" : "No";
            if (Column.IsNumeric)
                return Number(Value).toLocaleString(undefined, { minimumFractionDigits: Column.Decimals > 0 ? Column.Decimals : 0, maximumFractionDigits: Column.Decimals > 0 ? Column.Decimals : 2 });
            return String(Value);
        };

        var CellAlign = function (Column) {
            if (Column.IsBoolean)
                return "center";
            if (Column.IsNumeric || Column.IsDateTime)
                return "right";
            return "left";
        };

        var RenderTable = function () {
            var VisibleColumns = Table.Columns.filter(function (Column) { return Column.IsVisible; });
            var Html = [];
            Html.push("<table class=\"data-module-demo-table\"><thead><tr>");
            VisibleColumns.forEach(function (Column) {
                Html.push("<th>" + Column.DisplayTitle + "</th>");
            });
            Html.push("</tr></thead><tbody>");
            Table.Rows.forEach(function (Row) {
                Html.push("<tr>");
                VisibleColumns.forEach(function (Column) {
                    Html.push("<td data-align=\"" + CellAlign(Column) + "\">" + FormatValue(Column, Row.Get(Column)) + "</td>");
                });
                Html.push("</tr>");
            });
            Html.push("</tbody></table>");
            tp.Html("#DataModuleTableHost", Html.join(""));
        };

        tp.Html("#DataModuleSummary", ""
            + "<div><strong>Module</strong><br>" + Packet.Name + "</div>"
            + "<div><strong>DataSet</strong><br>" + DataSet.Name + "</div>"
            + "<div><strong>Tables</strong><br>" + DataSet.TableCount + "</div>"
            + "<div><strong>Item table</strong><br>" + Packet.ItemTableName + "</div>");

        RenderTable();
        tp.Text("#DataModuleJsonText", JSON.stringify(Packet, null, 2));
    });
</script>
