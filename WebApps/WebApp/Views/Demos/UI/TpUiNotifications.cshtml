@{
    ViewData["Title"] = "tp.Notifications";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.Notifications</h1>

<p>
    Notifications are small boxes displayed in the right bottom of the viewport, by default, for a certain period of time.
    They are also movable and resizable.
</p>

<p>
    The background color, the size and the display duration of notifications is controlled by global settings found in the
    <code>tp.NotificationBoxSetup</code> variable.
</p>

<style>
    .notifications-demo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }
    .notifications-demo-actions button {
        min-width: 120px;
    }
    .notifications-demo-options {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
    }
    .notifications-demo-log {
        box-sizing: border-box;
        width: min(100%, 760px);
        min-height: 110px;
        margin-top: 12px;
        padding: 12px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
    }
</style>

<div class="html-code">
    <div class="notifications-demo-actions">
        <button id="InfoButton" type="button">Info</button>
        <button id="WarningButton" type="button">Warning</button>
        <button id="SuccessButton" type="button">Success</button>
        <button id="ErrorButton" type="button">Error</button>
    </div>

    <div class="notifications-demo-options">
        <label>
            <input id="ToTopCheckBox" type="checkbox" />
            ToTop
        </label>
        <label>
            Duration
            <input id="DurationInput" type="number" min="2" max="30" value="10" />
        </label>
        <label>
            Max visible
            <input id="MaxVisibleInput" type="number" min="1" max="10" value="5" />
        </label>
    </div>

    <pre id="NotificationsOutput" class="notifications-demo-log"></pre>
</div>

<script class="js-code">
    tp.Ready(function () {
        var Counter = 0;

        var WriteLog = function (Message) {
            tp.Text("#NotificationsOutput", [
                Message || "Ready.",
                "duration seconds = " + tp.NotificationBoxSetup.DurationSecs,
                "max visible = " + tp.NotificationBoxSetup.MaxVisible,
                "to top = " + tp.NotificationBoxSetup.ToTop,
                "width = " + tp.NotificationBoxSetup.Width,
                "height = " + tp.NotificationBoxSetup.Height
            ].join("\n"));
        };

        var ApplyOptions = function () {
            tp.NotificationBoxSetup.ToTop = tp("#ToTopCheckBox").checked === true;
            tp.NotificationBoxSetup.DurationSecs = Math.max(2, tp.ToInt(tp("#DurationInput").value));
            tp.NotificationBoxSetup.MaxVisible = Math.max(1, tp.ToInt(tp("#MaxVisibleInput").value));
        };

        var Show = function (Type, Text) {
            Counter++;
            ApplyOptions();
            tp.Notify(Text + " #" + Counter, Type);
            WriteLog("Notification displayed.");
        };

        tp.On("#InfoButton", "click", function () {
            Show(tp.NotificationType.Information, "This is an information notification.");
        });

        tp.On("#WarningButton", "click", function () {
            Show(tp.NotificationType.Warning, "This is a warning notification.");
        });

        tp.On("#SuccessButton", "click", function () {
            Show(tp.NotificationType.Success, "This is a success notification.");
        });

        tp.On("#ErrorButton", "click", function () {
            Show(tp.NotificationType.Error, "This is an error notification.");
        });

        tp.On("#ToTopCheckBox", "change", function () {
            ApplyOptions();
            WriteLog("Options changed.");
        });

        tp.On("#DurationInput", "change", function () {
            ApplyOptions();
            WriteLog("Options changed.");
        });

        tp.On("#MaxVisibleInput", "change", function () {
            ApplyOptions();
            WriteLog("Options changed.");
        });

        WriteLog();
    });
</script>
