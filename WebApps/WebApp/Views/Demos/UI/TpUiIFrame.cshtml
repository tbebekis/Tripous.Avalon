@{
    ViewData["Title"] = "tp.IFrame";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.IFrame</h1>

<p>
    An iframe element.
    <br />
    The <code>Url</code> property controls what page the iframe displays.
    <br />
    The <code>Content</code> property is used when HTML content is passed to the iframe, instead of a Url.
    <br />
    The <code>UseSpinner</code> property controls whether to display a global spinner while loading a document to the iframe.
</p>

<style>
    .iframe-demo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }
    .iframe-demo-actions button {
        min-width: 120px;
    }
    .iframe-demo-host {
        box-sizing: border-box;
        width: min(100%, 900px);
        padding: 12px;
        border: 1px solid #8c959f;
        background: #ffffff;
    }
    #IFrame {
        width: 100%;
        height: 460px;
        background: #ffffff;
    }
    .iframe-demo-log {
        box-sizing: border-box;
        width: min(100%, 900px);
        min-height: 100px;
        margin-top: 12px;
        padding: 12px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
    }
</style>

<div class="html-code">
    <div class="iframe-demo-actions">
        <button id="LoadUrlButton" type="button">Load Local Url</button>
        <button id="LoadJSDocButton" type="button">Load JSDoc</button>
        <button id="LoadContentButton" type="button">Load Content</button>
        <button id="ToggleSpinnerButton" type="button">Use Spinner</button>
    </div>

    <div class="iframe-demo-host">
        <iframe id="IFrame"></iframe>
    </div>

    <pre id="IFrameOutput" class="iframe-demo-log"></pre>
</div>

<script class="js-code">
    tp.Ready(function () {
        var ContentHtml = [
            "<!doctype html>",
            "<html>",
            "<head>",
            "<style>",
            "body { margin: 0; padding: 24px; font: 15px Arial, sans-serif; color: #24292f; background: #f6f8fa; }",
            "main { max-width: 640px; padding: 18px; border: 1px solid #d0d7de; background: white; }",
            "h1 { margin-top: 0; font-size: 24px; }",
            "</style>",
            "</head>",
            "<body>",
            "<main>",
            "<h1>Inline iframe content</h1>",
            "<p>This HTML was assigned through the tp.IFrame Content property.</p>",
            "<p>The same component can switch back to Url mode.</p>",
            "</main>",
            "</body>",
            "</html>"
        ].join("");

        var Frame = new tp.IFrame("#IFrame", {
            Width: "100%",
            Height: 460,
            Url: "/demo/tp-ready",
            UseSpinner: true
        });
        var ShowSpinnerPreview = function () {
            tp.ShowSpinner(true);
            setTimeout(function () {
                tp.ShowSpinner(false);
            }, 900);
        };

        var UpdateSpinnerButton = function () {
            tp.Text("#ToggleSpinnerButton", Frame.UseSpinner ? "Test Spinner: On" : "Test Spinner: Off");
        };

        var WriteLog = function (Message) {
            UpdateSpinnerButton();
            tp.Text("#IFrameOutput", [
                Message || "Ready.",
                "url = " + (Frame.Url || ""),
                "supports srcdoc = " + Frame.SupportsSrcDoc,
                "use spinner = " + Frame.UseSpinner,
                "width = " + Frame.Width,
                "height = " + Frame.Height
            ].join("\n"));
        };

        tp.On("#LoadUrlButton", "click", function () {
            Frame.Url = "/demo/tp-ready";
            WriteLog("Local Url loaded.");
        });

        tp.On("#LoadJSDocButton", "click", function () {
            Frame.Url = "https://jsdoc.app/";
            WriteLog("JSDoc Url loaded.");
        });

        tp.On("#LoadContentButton", "click", function () {
            Frame.Content = ContentHtml;
            WriteLog("Inline content loaded.");
        });

        tp.On("#ToggleSpinnerButton", "click", function () {
            Frame.UseSpinner = !Frame.UseSpinner;
            if (Frame.UseSpinner)
                ShowSpinnerPreview();
            WriteLog("UseSpinner toggled.");
        });

        Frame.On("Loaded", function () {
            WriteLog("Frame loaded.");
        });

        UpdateSpinnerButton();
        WriteLog();
    });
</script>
