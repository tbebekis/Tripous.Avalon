@{
    ViewData["Title"] = "data-setup";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>data-setup</h1>

<p>
    The <code>data-setup</code> attribute is the declarative initialization hook used by Tripous components.
    It lets server-rendered or static markup carry the same options that could otherwise be passed from JavaScript
    to a component constructor. When a <code>tp.Component</code> creates or wraps its handle, it reads the
    <code>data-setup</code> object, merges it into the component create params, and then calls the component
    <code>ApplyCreateParams()</code> method.
</p>

<p>
    The value is a JavaScript object literal, not strict JSON. Property names may be unquoted and strings may use
    single quotes. This is intentional because the old Tripous demos and Razor-generated markup use compact
    object-literal syntax. The attribute is read during component construction; changing the attribute later does
    not reconfigure an existing component. To change a control after construction, use its public properties.
</p>

<p>
    A property has effect only when the component explicitly supports it. Common base properties such as
    <code>Text</code>, <code>ToolTip</code>, <code>CssClasses</code>, and <code>TabIndex</code> are handled by
    <code>tp.Component</code>. Control-specific properties such as <code>Decimals</code>, <code>SelectedValue</code>,
    <code>Date</code>, <code>Placeholder</code>, or <code>ImageUrl</code> are handled by the concrete class.
    This keeps initialization predictable and avoids a generic "assign anything" rule.
</p>

<p>
    For a more advanced example, see the <a href="/demo/tp-ui-ctrl-row">tp.CtrlRow demo</a>. It shows how
    <code>data-setup</code> can initialize a row label and a nested control declaration in the same markup.
</p>

<style>
    .data-setup-demo-grid {
        display: grid;
        grid-template-columns: minmax(260px, 360px) minmax(300px, 1fr);
        gap: 14px;
        align-items: start;
        width: min(100%, 980px);
    }
    .data-setup-demo-panel {
        display: grid;
        gap: 10px;
        min-width: 0;
    }
    .data-setup-demo-example {
        display: grid;
        gap: 8px;
        padding: 10px;
        border: 1px solid #d0d7de;
        background: #ffffff;
    }
    .data-setup-demo-example h2 {
        margin: 0;
        font-size: 16px;
    }
    .data-setup-demo-example p {
        margin: 0;
    }
    .data-setup-demo-code {
        margin: 0;
        padding: 10px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
        white-space: pre;
    }
    .data-setup-demo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin: 12px 0;
    }
    .data-setup-demo-log {
        box-sizing: border-box;
        width: min(100%, 980px);
        min-height: 170px;
        padding: 12px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
    }
    #DataSetupTextBox,
    #DataSetupNumberBox {
        width: 220px;
        height: 30px;
        box-sizing: border-box;
    }
    #DataSetupComboBox,
    #DataSetupDateBox {
        width: 220px;
        height: 30px;
    }
    #DataSetupTreeView {
        width: 280px;
        height: 170px;
    }
    @@media (max-width: 840px) {
        .data-setup-demo-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<div class="html-code">
    <div class="data-setup-demo-grid">
        <div class="data-setup-demo-panel">
            <section class="data-setup-demo-example">
                <h2>TextBox</h2>
                <p>Base text and input-specific options are applied before the first render.</p>
                <input id="DataSetupTextBox" type="text" data-setup="{ Text: 'Tripous Web', Placeholder: 'project name', MaxLength: 40, ToolTip: 'Initialized by data-setup' }" />
            </section>

            <section class="data-setup-demo-example">
                <h2>NumberBox</h2>
                <p>The text box is configured as a numeric control with decimal formatting.</p>
                <input id="DataSetupNumberBox" type="text" data-setup="{ Value: 1234.5, Decimals: 2, Placeholder: 'amount' }" />
            </section>

            <section class="data-setup-demo-example">
                <h2>ComboBox</h2>
                <p>Object lists can be declared inline when the markup owns the list.</p>
                <div id="DataSetupComboBox" data-setup="{ ListOnly: true, ListValueField: 'Id', ListDisplayField: 'Name', SelectedValue: 'GR', List: [{ Id: 'GR', Name: 'Greece' }, { Id: 'CY', Name: 'Cyprus' }, { Id: 'IT', Name: 'Italy' }] }"></div>
            </section>

            <section class="data-setup-demo-example">
                <h2>DateBox</h2>
                <p>Date text is parsed through the same date helper used by the control.</p>
                <div id="DataSetupDateBox" data-setup="{ Date: '4/1', Placeholder: 'date', TextAlign: 'right' }"></div>
            </section>

            <section class="data-setup-demo-example">
                <h2>TreeView</h2>
                <p>Nested markup can combine root setup and per-node setup.</p>
                <div id="DataSetupTreeView" data-setup="{ Expanded: true }">
                    <div data-setup="{ ImageUrl: '/tp/images/demos/Home.png', ToolTip: 'Home node' }">
                        Home
                        <div>Dashboard</div>
                        <div>Reports</div>
                    </div>
                    <div data-setup="{ Url: 'https://w3c.github.io/html/dom.html', ToolTip: 'Opens in a new browser tab' }">HTML DOM reference</div>
                </div>
            </section>
        </div>

        <div class="data-setup-demo-panel">
            <pre class="data-setup-demo-code">&lt;input id="DataSetupTextBox"
       type="text"
       data-setup="{ Text: 'Tripous Web',
                     Placeholder: 'project name',
                     MaxLength: 40,
                     ToolTip: 'Initialized by data-setup' }" /&gt;</pre>

            <pre class="data-setup-demo-code">&lt;input id="DataSetupNumberBox"
       type="text"
       data-setup="{ Value: 1234.5,
                     Decimals: 2,
                     Placeholder: 'amount' }" /&gt;</pre>

            <pre class="data-setup-demo-code">&lt;div id="DataSetupComboBox"
     data-setup="{ ListOnly: true,
                   ListValueField: 'Id',
                   ListDisplayField: 'Name',
                   SelectedValue: 'GR',
                   List: [
                       { Id: 'GR', Name: 'Greece' },
                       { Id: 'CY', Name: 'Cyprus' },
                       { Id: 'IT', Name: 'Italy' }
                   ] }"&gt;&lt;/div&gt;</pre>

            <pre class="data-setup-demo-code">&lt;div id="DataSetupDateBox"
     data-setup="{ Date: '4/1',
                   Placeholder: 'date',
                   TextAlign: 'right' }"&gt;&lt;/div&gt;</pre>

            <pre class="data-setup-demo-code">&lt;div id="DataSetupTreeView" data-setup="{ Expanded: true }"&gt;
    &lt;div data-setup="{ ImageUrl: '/tp/images/demos/Home.png',
                       ToolTip: 'Home node' }"&gt;
        Home
        &lt;div&gt;Dashboard&lt;/div&gt;
        &lt;div&gt;Reports&lt;/div&gt;
    &lt;/div&gt;
    &lt;div data-setup="{ Url: 'https://w3c.github.io/html/dom.html',
                       ToolTip: 'Opens in a new browser tab' }"&gt;
        HTML DOM reference
    &lt;/div&gt;
&lt;/div&gt;</pre>
        </div>
    </div>

    <div class="data-setup-demo-actions">
        <button id="DataSetupLogButton" type="button">Log Values</button>
        <button id="DataSetupChangeButton" type="button">Change After Construction</button>
    </div>

    <pre id="DataSetupOutput" class="data-setup-demo-log"></pre>
</div>

<script class="js-code">
    tp.Ready(function () {
        var TextBox = new tp.TextBox({
            ElementOrSelector: "#DataSetupTextBox"
        });
        var NumberBox = new tp.NumberBox({
            ElementOrSelector: "#DataSetupNumberBox"
        });
        var ComboBox = new tp.ComboBox({
            ElementOrSelector: "#DataSetupComboBox"
        });
        var DateBox = new tp.DateBox({
            ElementOrSelector: "#DataSetupDateBox"
        });
        var TreeView = new tp.TreeView({
            ElementOrSelector: "#DataSetupTreeView"
        });

        var FormatDate = function (Value) {
            return tp.IsValidDate(Value) ? tp.FormatDateTime(Value, "yyyy-MM-dd") : "";
        };

        var WriteLog = function (Message) {
            tp.Text("#DataSetupOutput", [
                Message || "Ready.",
                "TextBox.Text = " + TextBox.Text,
                "TextBox.Placeholder = " + TextBox.Placeholder,
                "NumberBox.Text = " + NumberBox.Text,
                "NumberBox.Value = " + NumberBox.Value,
                "NumberBox.Decimals = " + NumberBox.Decimals,
                "ComboBox.Count = " + ComboBox.Count,
                "ComboBox.SelectedValue = " + ComboBox.SelectedValue,
                "DateBox.Text = " + DateBox.Text,
                "DateBox.Date = " + FormatDate(DateBox.Date),
                "TreeView.Count = " + TreeView.Count
            ].join("\n"));
        };

        tp.On("#DataSetupLogButton", "click", function () {
            WriteLog("Current values.");
        });

        tp.On("#DataSetupChangeButton", "click", function () {
            TextBox.Text = "Changed by property assignment";
            NumberBox.Value = 9876.5;
            ComboBox.SelectedValue = "IT";
            DateBox.Date = "2026-12-31";
            TreeView.AddNode("Added after construction");
            WriteLog("Changed by public properties, not by editing data-setup.");
        });

        WriteLog();
    });
</script>
