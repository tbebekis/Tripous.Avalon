@{
    ViewData["Title"] = "tp.ScreenOverlay / tp.Spinner";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.ScreenOverlay / tp.Spinner</h1>

<p>This demo checks the first Tripous UI services.</p>

<style>
    .overlay-spinner-demo {
        grid-template-columns: max-content 72px max-content max-content;
        max-width: 560px;
    }
    .overlay-spinner-demo label {
        font-weight: 600;
    }
    .overlay-spinner-demo input {
        width: 72px;
    }
    .overlay-spinner-demo button {
        min-width: 0;
        width: auto;
    }
</style>

<div class="html-code">
    <div class="demo-panel overlay-spinner-demo">
        <label for="DurationSeconds">Seconds</label>
        <input id="DurationSeconds" type="number" min="1" max="10" step="1" value="2" />
        <button id="ShowOverlayButton" type="button">Show Overlay</button>
        <button id="ShowSpinnerButton" type="button">Show Spinner</button>
        <pre id="DemoOutput"></pre>
    </div>
</div>

<script class="js-code">
    tp.Ready(function () {
        var Overlay = null;
        var OverlayTimerId = 0;

        var WriteLog = function (Message) {
            var Lines = [
                Message,
                "overlay visible = " + (Overlay ? Overlay.Visible : false),
                "spinner showing = " + tp.Spinner.IsShowing,
                "spinner counter = " + tp.Spinner.ShowingCounter,
                "time = " + new Date().toLocaleTimeString()
            ];

            tp.Text("#DemoOutput", Lines.join("\n"));
        };

        var GetDuration = function () {
            var Result = Number(tp.Value("#DurationSeconds"));

            if (!Number.isFinite(Result))
                Result = 2;

            Result = Math.max(1, Math.min(10, Result));
            tp.Value("#DurationSeconds", Result);

            return Result * 1000;
        };

        tp.On("#ShowOverlayButton", "click", function () {
            if (!Overlay)
                Overlay = new tp.ScreenOverlay();

            clearTimeout(OverlayTimerId);

            Overlay.Show();
            WriteLog("Overlay shown.");

            OverlayTimerId = setTimeout(function () {
                if (Overlay)
                    Overlay.Hide();

                WriteLog("Overlay auto-hidden.");
            }, GetDuration());
        });

        tp.On("#ShowSpinnerButton", "click", function () {
            tp.ShowSpinner(true);
            WriteLog("Spinner show requested.");

            setTimeout(function () {
                tp.ShowSpinner(false);
                WriteLog("Spinner auto-hidden.");
            }, GetDuration());
        });

        WriteLog("Ready.");
    });
</script>
