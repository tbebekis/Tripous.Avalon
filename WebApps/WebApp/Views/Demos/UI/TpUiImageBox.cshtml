@{
    ViewData["Title"] = "tp.ImageBox";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.ImageBox</h1>

<p>
    An image control based on a <code>div</code> element and CSS background properties.
    It is not an <code>img</code> element.
</p>

<p>
    Change the image mode to test <code>Crop</code>, <code>Scale</code>, and <code>Stretch</code>.
</p>

<style>
    .image-box-demo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }
    .image-box-demo-actions select {
        min-width: 140px;
    }
    .image-box-demo-frame {
        box-sizing: border-box;
        width: min(100%, 420px);
        padding: 8px;
        border: 1px solid #d0d7de;
        margin-bottom: 12px;
    }
    .image-box-demo-log {
        box-sizing: border-box;
        width: min(100%, 700px);
        min-height: 110px;
        padding: 12px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
    }
</style>

<div class="html-code">
    <div class="image-box-demo-actions">
        <label for="ImageBoxMode">Image mode</label>
        <select id="ImageBoxMode">
            <option value="Crop">Crop</option>
            <option value="Scale">Scale</option>
            <option value="Stretch">Stretch</option>
        </select>
        <button id="ImageBoxGardenButton" type="button">Garden</button>
        <button id="ImageBoxKefaloniaButton" type="button">Kefalonia</button>
        <button id="ImageBoxLogButton" type="button">Log</button>
    </div>

    <div class="image-box-demo-frame">
        <div id="ImageBox" data-setup='{ Url: "/tp/images/demos/Kefalonia.jpg", Width: "100%", Height: 260, ImageMode: "Crop" }'></div>
    </div>

    <pre id="ImageBoxOutput" class="image-box-demo-log"></pre>
</div>

<script class="js-code">
    tp.Ready(function () {
        var ImageBox = new tp.ImageBox({
            ElementOrSelector: "#ImageBox"
        });
        var ModeSelect = tp("#ImageBoxMode");

        var ModeName = function (Mode) {
            if (Mode === tp.ImageSizeMode.Crop)
                return "Crop";
            if (Mode === tp.ImageSizeMode.Scale)
                return "Scale";
            if (Mode === tp.ImageSizeMode.Stretch)
                return "Stretch";
            return "Unknown";
        };

        var WriteLog = function (Message) {
            tp.Text("#ImageBoxOutput", [
                Message || "Ready.",
                "url = " + ImageBox.Url,
                "image mode = " + ModeName(ImageBox.ImageMode),
                "width = " + ImageBox.Width,
                "height = " + ImageBox.Height
            ].join("\n"));
        };

        tp.On(ModeSelect, "change", function () {
            ImageBox.ImageMode = ModeSelect.value;
            WriteLog("Image mode changed.");
        });

        tp.On("#ImageBoxGardenButton", "click", function () {
            ImageBox.Url = "/tp/images/demos/Garden.jpg";
            WriteLog("Image changed.");
        });

        tp.On("#ImageBoxKefaloniaButton", "click", function () {
            ImageBox.Url = "/tp/images/demos/Kefalonia.jpg";
            WriteLog("Image changed.");
        });

        tp.On("#ImageBoxLogButton", "click", function () {
            WriteLog("Current values.");
        });

        WriteLog();
    });
</script>
