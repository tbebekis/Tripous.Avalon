@{
    ViewData["Title"] = "tp.CheckBox";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.CheckBox</h1>

<p>
    A check box control built on a clickable <code>label</code> element.
    The inner input stays on the left and the text wraps on the right when it is long.
</p>

<p>
    Click each label text to toggle the check box. The long text case verifies that the check box remains aligned with the first line while the text wraps.
</p>

<style>
    .check-box-demo-list {
        display: grid;
        gap: 14px;
        width: min(100%, 640px);
        margin-bottom: 14px;
    }
    .check-box-demo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }
    .check-box-demo-log {
        box-sizing: border-box;
        width: min(100%, 680px);
        min-height: 120px;
        padding: 12px;
        overflow: auto;
        border: 1px solid #d0d7de;
        background: #f0f3f6;
    }
</style>

<div class="html-code">
    <div class="check-box-demo-list">
        <label id="CheckBoxShort"></label>
        <label id="CheckBoxChecked"></label>
        <label id="CheckBoxLong"></label>
    </div>

    <div class="check-box-demo-actions">
        <button id="CheckBoxChangeTextButton" type="button">Change Long Text</button>
        <button id="CheckBoxLogButton" type="button">Log</button>
    </div>

    <pre id="CheckBoxOutput" class="check-box-demo-log"></pre>
</div>

<script class="js-code">
    tp.Ready(function () {
        var LongText = "This is a long check box label. It should wrap to multiple lines while the check box remains aligned with the first line, not vertically centered in the full text block.";
        var LongTextAlt = "Updated long text. This verifies that the tp.CheckBox.Text property changes the label content and keeps the same wrapping layout with a large amount of text in the right-hand text area.";
        var CheckBoxShort = new tp.CheckBox({
            ElementOrSelector: "#CheckBoxShort",
            Text: "Short label"
        });
        var CheckBoxChecked = new tp.CheckBox({
            ElementOrSelector: "#CheckBoxChecked",
            Text: "Initially checked",
            Checked: true
        });
        var CheckBoxLong = new tp.CheckBox({
            ElementOrSelector: "#CheckBoxLong",
            Text: LongText
        });

        var WriteLog = function (Message) {
            tp.Text("#CheckBoxOutput", [
                Message || "Ready.",
                "short checked = " + CheckBoxShort.Checked,
                "checked checked = " + CheckBoxChecked.Checked,
                "long checked = " + CheckBoxLong.Checked,
                "long text length = " + CheckBoxLong.Text.length
            ].join("\n"));
        };

        var Hook = function (CheckBox) {
            CheckBox.On("ValueChanged", function () {
                WriteLog("Value changed.");
            });
        };

        Hook(CheckBoxShort);
        Hook(CheckBoxChecked);
        Hook(CheckBoxLong);

        tp.On("#CheckBoxChangeTextButton", "click", function () {
            CheckBoxLong.Text = CheckBoxLong.Text === LongText ? LongTextAlt : LongText;
            WriteLog("Long text changed.");
        });

        tp.On("#CheckBoxLogButton", "click", function () {
            WriteLog("Current values.");
        });

        WriteLog();
    });
</script>
