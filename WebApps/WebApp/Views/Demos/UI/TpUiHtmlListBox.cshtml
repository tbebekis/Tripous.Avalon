@{
    ViewData["Title"] = "tp.HtmlListBox";
}

@await Html.PartialAsync("Demos.IndexLink")

<h1>tp.HtmlListBox</h1>

<p>
    This demo shows the native HTML list box wrapped by <code>tp.HtmlListBox</code>. Toggle multi-select, select one or more items, and check the log.
</p>

<style>
    .demo-row {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
    }

    .demo-options {
        display: grid;
        gap: 8px;
        min-width: 180px;
    }

    .demo-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 12px 0;
    }

    #HtmlListLog {
        min-height: 160px;
        white-space: pre-wrap;
    }
</style>

<div class="demo-row">
    <select id="HtmlListBox" data-setup="{ Width: 240, Height: 170, List: ['Athens', 'Thessaloniki', 'Patras', 'Heraklion', 'Larissa', 'Volos', 'Ioannina', 'Chania', 'Kavala', 'Rhodes'], SelectedIndex: 0 }"></select>

    <div class="demo-options">
        <label>
            <input id="HtmlListMultiSelectCheckBox" type="checkbox">
            MultiSelect
        </label>
        <span>Use Ctrl or Shift in the list when multi-select is enabled.</span>
    </div>
</div>

<div class="demo-buttons">
    <button id="HtmlListSelectFirstButton" type="button">Select First</button>
    <button id="HtmlListSelectSomeButton" type="button">Select Some</button>
    <button id="HtmlListSetListButton" type="button">Set 100 Items</button>
    <button id="HtmlListLogButton" type="button">Log</button>
</div>

<pre id="HtmlListLog"></pre>

<script>
    tp.Ready(function () {
        var HtmlListBox = new tp.HtmlListBox({
            ElementOrSelector: "#HtmlListBox",
            VisibleItemCount: 8
        });

        var CreateLargeList = function (Count) {
            var Result = [];
            for (var i = 0; i < Count; i++)
                Result.push("Item " + tp.PadLeft(i + 1, "0", 3));
            return Result;
        };

        var WriteLog = function (Message) {
            var Lines = [];
            if (Message)
                Lines.push(Message);

            Lines.push("Count: " + HtmlListBox.Count);
            Lines.push("MultiSelect: " + HtmlListBox.MultiSelect);
            Lines.push("SelectedIndex: " + HtmlListBox.SelectedIndex);
            Lines.push("SelectedValue: " + HtmlListBox.SelectedValue);
            Lines.push("SelectedIndexes: " + HtmlListBox.SelectedIndexes.join(", "));
            Lines.push("SelectedValues: " + HtmlListBox.SelectedValues.join(", "));

            tp.Select("#HtmlListLog").textContent = Lines.join("\n");
        };

        HtmlListBox.On("SelectedIndexChanged", function () {
            WriteLog("Selection changed.");
        });

        tp.On("#HtmlListMultiSelectCheckBox", "change", function (e) {
            HtmlListBox.MultiSelect = e.target.checked;
            WriteLog("MultiSelect changed.");
        });

        tp.On("#HtmlListSelectFirstButton", "click", function () {
            HtmlListBox.SelectedIndex = 0;
            WriteLog("First item selected.");
        });

        tp.On("#HtmlListSelectSomeButton", "click", function () {
            HtmlListBox.MultiSelect = true;
            tp.Select("#HtmlListMultiSelectCheckBox").checked = true;
            HtmlListBox.SelectedIndexes = [1, 3, 5];
            WriteLog("Items 1, 3, and 5 selected.");
        });

        tp.On("#HtmlListSetListButton", "click", function () {
            HtmlListBox.List = CreateLargeList(100);
            HtmlListBox.SelectedIndex = 50;
            WriteLog("List replaced with 100 items.");
        });

        tp.On("#HtmlListLogButton", "click", function () {
            WriteLog("Current values.");
        });

        WriteLog();
    });
</script>
